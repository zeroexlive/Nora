// Marble from fractal noise, with a user function and a loop.
float fbm(point p, int octaves)
{
    float sum = 0, amp = 0.5;
    point q = p;
    for (int i = 0; i < octaves; i++) {
        sum += amp * noise("perlin", q);
        q *= 2.03;
        amp *= 0.5;
    }
    return sum;
}

surface marble(
    float scale = 2.5,
    color vein = color(0.12, 0.12, 0.15),
    color stone = color(0.92, 0.9, 0.86),
    float roughness = 0.12)
{
    point p = P * scale;
    float t = 0.5 + 0.5 * sin(p[0] * 3.0 + 6.0 * fbm(p, 5));
    color base = mix(vein, stone, pow(t, 0.6));
    Ci = base * diffuse(N) + 0.6 * microfacet("ggx", N, roughness * roughness, 1.5, 0);
}
